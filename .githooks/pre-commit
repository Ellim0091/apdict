#!/usr/bin/env bash
# Blocks commits that contain secrets. Needs gitleaks: brew install gitleaks
set -euo pipefail
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks is not installed. Run: brew install gitleaks" >&2
  exit 1
fi
if gitleaks git --help >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact -v
else
  gitleaks protect --staged --redact -v
fi
